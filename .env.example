# Set only when using the Netlify demo-request function or another endpoint.
# Plain Vite development leaves this empty and uses the WhatsApp fallback.
# VITE_DEMO_ENDPOINT=/.netlify/functions/demo

# Optional: business WhatsApp number in international format, digits only.
# Without a number, WhatsApp opens its contact picker with the message prefilled.
# VITE_WHATSAPP_NUMBER=
